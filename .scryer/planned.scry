    {
      "id": "node-9kxc39",
      "kind": "component",
      "name": "Probe Worktree Manager",
      "parentId": "node-t58dyd",
      "description": "Maintains an isolated git worktree per project mirroring its current state, for safely testing hypothetical changes.",
      "responsibilities": [
        {
          "id": "resp-n3601j",
          "statement": "Maintains a persistent, isolated git worktree per project (outside the developer's own checkout) that mirrors its current committed + uncommitted state, so a probe can safely test hypothetical changes.",
          "lastTouchedAt": 1788959020
        },
        {
          "id": "resp-m41j2p",
          "statement": "Syncs, applies patches to, and resets the worktree between probe rounds without ever touching the developer's real files.",
          "lastTouchedAt": 1788959020
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-twsamp",
      "kind": "symbol",
      "name": "is_git_repo",
      "parentId": "node-9kxc39",
      "responsibilities": [
        {
          "id": "resp-e3vr08",
          "statement": "Refuses rather than downgrades when the project isn't a git repository — mutating the developer's own files is exactly what the worktree exists to prevent.",
          "lastTouchedAt": 1788959020
        }
      ]
    },
    {
      "id": "node-2dfpnx",
      "kind": "symbol",
      "name": "worktree_path",
      "parentId": "node-9kxc39",
      "responsibilities": [
        {
          "id": "resp-kvgz4h",
          "statement": "The deterministic worktree path for a project, keyed by a hash of its absolute path.",
          "lastTouchedAt": 1788959020
        }
      ]
    },
    {
      "id": "node-h28yh2",
      "kind": "symbol",
      "name": "ensure_synced",
      "parentId": "node-9kxc39",
      "responsibilities": [
        {
          "id": "resp-kh076k",
          "statement": "Hands back a worktree synced to the project's current commits plus uncommitted/untracked edits, creating it on first use and reusing it (build cache and all) after.",
