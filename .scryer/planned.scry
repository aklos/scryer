    {
      "id": "node-535",
      "kind": "component",
      "name": "Model Storage & Concurrency",
      "parentId": "node-4",
      "description": "Persists and locks the committed/planned model files and merges them into the working view.",
      "responsibilities": [
        {
          "id": "resp-582",
          "statement": "Persists the committed and planned model layers to disk with atomic writes and exclusive file locking",
          "lastTouchedAt": 1784884312
        },
        {
          "id": "resp-583",
          "statement": "Merges the committed and planned layers into the single working view every reader consumes",
          "lastTouchedAt": 1784884312
        },
        {
          "id": "resp-584",
          "statement": "Dates each claim's last-touched fossilization timestamp only when its truth-bearing content changes",
          "lastTouchedAt": 1784884312
        }
      ]
    },
    {
      "id": "node-536",
