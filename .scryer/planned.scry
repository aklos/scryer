        }
      ]
    },
    {
      "id": "node-539",
      "kind": "symbol",
      "name": "read_model_at",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-587",
          "statement": "**If** a model file's schema version does not match the current version, **then** refuse to load it",
