      "kind": "symbol",
      "name": "ModelLock",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-585",
          "statement": "Holds the exclusive advisory lock for the whole read-modify-write cycle of a model edit",
          "lastTouchedAt": 1784884312
        }
      ]
    },
    {
      "id": "node-538",
      "kind": "symbol",
      "name": "lock_model",
      "parentId": "node-535",
      "responsibilities": [
        {
