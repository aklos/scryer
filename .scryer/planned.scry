        }
      ]
    },
    {
      "id": "node-542",
      "kind": "symbol",
      "name": "write_planned_at",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-590",
          "statement": "Persists the planned draft and garbage-collects change tags an edit reverted back to committed form",
          "lastTouchedAt": 1784884312
        }
      ]
    },
    {
      "id": "node-543",
      "kind": "symbol",
      "name": "working_view",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-591",
          "statement": "Overlays committed's single-home anchors and boundaries onto the plan's authored structure for any consumer that must see both",
