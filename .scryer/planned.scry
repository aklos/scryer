    {
      "id": "node-8ha83j",
      "kind": "component",
      "name": "Model Validator",
      "parentId": "node-t58dyd",
      "description": "Runs structural validation of a model against its styles, isolating hard invariant breaks from advisories.",
      "responsibilities": [
        {
          "id": "resp-h0fm4t",
          "statement": "Runs structural validation of a model against its styles, producing human-readable warnings from field-length caps to style/layer membership to unreachable components.",
          "lastTouchedAt": 1788959020
        },
        {
          "id": "resp-c85pkk",
          "statement": "Isolates the subset of warnings that are hard structural-invariant violations (duplicate/reused ids) — the ones that must gate a committed write, versus advisories that don't.",
          "lastTouchedAt": 1788959020
        },
        {
          "id": "resp-27k733",
          "statement": "Checks a model's source-map coverage against the real filesystem for gaps and cross-boundary sharing.",
          "lastTouchedAt": 1788959020
        },
        {
          "id": "resp-2d3a7e",
          "statement": "Ships a diagnostic CLI (dump_validate) that runs the real validator against a project and prints every warning category.",
          "lastTouchedAt": 1788959020
        }
      ],
      "layer": "domain"
    },
    {
