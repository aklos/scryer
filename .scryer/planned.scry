      "responsibilities": [
        {
          "id": "resp-128",
          "statement": "Applies raw whole-node and whole-model rewrites while preserving user-owned fields the typed tools can't reach.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-129",
          "statement": "Folds implemented plan work into the committed model, relocating a removed node's own claims to its nearest surviving ancestor instead of losing them.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-130",
          "statement": "Reparents, moves, deletes, and descopes nodes with full cascade cleanup of their links, boundaries, and anchors.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-131",
          "statement": "Moves individual responsibilities between nodes.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-98",
      "kind": "symbol",
      "name": "replace_subtree",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-132",
          "statement": "Replaces a node's whole subtree in one model layer, dropping every current descendant and inserting the payload's, skipping any link with an unresolved endpoint.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-99",
      "kind": "symbol",
      "name": "fold_out_layer",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-133",
          "statement": "Removes a set of target nodes from one model layer, relocating each target's own claims up to its parent before the removal so no claim goes dark.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-100",
      "kind": "symbol",
      "name": "fold_change_by_id",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-134",
          "statement": "Folds every plan entry tagged to one named change into the committed model in dependency order, closing the change once its last entry folds.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-101",
      "kind": "symbol",
      "name": "surviving_ancestor",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-135",
          "statement": "Finds the nearest ancestor of a node that is not itself being removed, the surviving home for a descoped node's relocated claims.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-102",
      "kind": "symbol",
      "name": "set_model",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-136",
          "statement": "Replaces the entire model from raw JSON, re-minting invented ids and restoring directives and positions before it lands.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-103",
      "kind": "symbol",
      "name": "update_nodes",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-137",
          "statement": "Patches node fields and reparents nodes, enforcing the same kind/cycle validation as move_nodes and preserving vagrant claims a replacement omits.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-104",
      "kind": "symbol",
      "name": "mark_implemented",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-138",
          "statement": "Folds a node's, a change's, or specific claims'/properties'/links'/groups' outstanding plan work into the committed model, optionally anchoring and attaching tests atomically.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-105",
      "kind": "symbol",
      "name": "move_nodes",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-139",
          "statement": "Reparents nodes with kind and cycle validation, clearing canvas position on a real reparent and evicting the node from its old-level group.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-106",
      "kind": "symbol",
      "name": "set_node",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-140",
          "statement": "Replaces one node's subtree from raw JSON describing code that already exists, committing it to both model layers so it never reads as pending.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-107",
      "kind": "symbol",
      "name": "delete_nodes",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-141",
          "statement": "Stages the deletion of nodes and their descendants, and any links between them, in the plan.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-108",
      "kind": "symbol",
      "name": "descope",
      "parentId": "node-97",
      "responsibilities": [
        {
          "id": "resp-142",
          "statement": "Removes nodes that shouldn't be modeled from both the plan and committed layers at once, relocating their own claims and leaving the code untouched.",
