        }
      ]
    },
    {
      "id": "node-545",
      "kind": "symbol",
      "name": "read_planned_seeded_at",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-593",
          "statement": "Seeds a clean draft before any write that authors into the plan, so the draft never shadows committed's anchors",
