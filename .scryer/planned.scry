        }
      ]
    },
    {
      "id": "node-540",
      "kind": "symbol",
      "name": "write_model_at",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-588",
          "statement": "Persists the committed model atomically and strips any change-ledger state, which lives only in the plan",
