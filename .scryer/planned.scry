      "name": "Agent Sync Entry Points",
      "parentId": "node-attjm8",
      "description": "The crate's public entry: probes PATH for an agent to launch, and hands other containers a handle that starts and cancels sessions without naming the runtime.",
      "responsibilities": [
        {
          "id": "resp-nrkf2x",
          "statement": "**Resolve** which agent a session launches with, honoring the user's preference and falling back in a fixed order when it is not installed.",
          "lastTouchedAt": 1789203574
        },
        {
          "id": "resp-7zjaep",
          "statement": "**Hand** another container a handle that starts and cancels agent sessions, keeping the subprocess runtime private to this crate.",
          "lastTouchedAt": 1789203574
        }
      ],
      "layer": "composition"
    },
    {
      "id": "node-nabyx6",
      "kind": "component",
      "name": "Anchor Store",
      "parentId": "node-6k1s6z",
      "description": "Fingerprints anchors against the real files and the stored model, and owns the .scryer/.anchors.json baseline.",
      "responsibilities": [
        {
          "id": "resp-ewdkmw",
          "statement": "Fingerprints every source-anchored claim in the model against the working tree, so an edit, move, or deletion of the anchored code can be detected on demand.",
          "lastTouchedAt": 1789204433
        },
        {
          "id": "resp-vfz9ek",
          "statement": "Distinguishes benign symbol moves (silently re-anchored) from real content drift, and rescues renamed files by content match before reporting them missing.",
          "lastTouchedAt": 1789204433
        },
        {
          "id": "resp-m527dq",
          "statement": "Surfaces out-of-plan regressions to already-mapped code as scoped drift, suppressing changes the current plan already accounts for.",
          "lastTouchedAt": 1789204433
        },
        {
          "id": "resp-ffx6em",
          "statement": "**Persist** and **read back** the anchor baseline the tripwire compares against.",
          "lastTouchedAt": 1789204360
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-hfseer",
      "kind": "component",
      "name": "Test Verdict Store",
      "parentId": "node-6k1s6z",
      "description": "Owns the on-disk verdict cache and the freshness checks that read the model and the files behind it.",
      "responsibilities": [
        {
          "id": "resp-7wyz11",
          "statement": "**Persist** each claim's test and probe verdicts, fingerprinted so a later edit shows as stale.",
          "lastTouchedAt": 1789204360
        },
        {
          "id": "resp-prywdx",
          "statement": "**Resolve** whether a cached verdict still describes the code, from the anchored span and the file's mtime.",
          "lastTouchedAt": 1789204360
        },
        {
          "id": "resp-hp3k5v",
          "statement": "**If** a claim has no code anchor, **then** **leaves** it out of the claims a session must probe",
          "lastTouchedAt": 1790942956
        },
        {
          "id": "resp-92f39s",
          "statement": "**When** a report is ingested, **keeps** every case's outcome, including tests not yet attached to any claim",
          "lastTouchedAt": 1790943466
        },
        {
          "id": "resp-ba09vk",
          "statement": "**When** a test is attached after its report was ingested, **records** the kept outcome for its claim, unless the claim's code or test changed since that ingest",
          "lastTouchedAt": 1790943466
        },
        {
          "id": "resp-1s35xd",
          "statement": "**When** anchors or tests are added to a claim with a current verdict, **refingerprints** the verdict, unless a span it recorded changed or a newly anchored file was modified since its run",
          "lastTouchedAt": 1790949849
        },
        {
          "id": "resp-vfpenc",
          "statement": "**If** a stored probe round tried no break, **then** **leaves** it out of the claim's probe status",
          "lastTouchedAt": 1790962681
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-jtaw7p",
      "kind": "component",
      "name": "Source Walker",
      "parentId": "node-6k1s6z",
      "description": "Reads the project off disk: which files exist, and their parse trees, with an in-process parse cache.",
      "responsibilities": [
        {
          "id": "resp-1wye1f",
          "statement": "**Walk** a project for its files, skipping the vendor and build directories the extractor ignores.",
          "lastTouchedAt": 1789204360
        },
        {
          "id": "resp-y95g9g",
          "statement": "**Parse** every product source file in parallel, reusing cached parse trees for unchanged content.",
          "lastTouchedAt": 1789204360
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-p5p377",
      "kind": "component",
      "name": "Model File Store",
      "parentId": "node-t58dyd",
      "description": "The files the model lives in: both layers, the history log, the refusal ledger, the settings file and the edge cache.",
      "responsibilities": [
        {
          "id": "resp-mwnhyq",
          "statement": "**Read** and **write** the committed and planned layers, under a lock, with the version check and write gates each one owes.",
          "lastTouchedAt": 1789205493
        },
        {
          "id": "resp-2pvwdj",
          "statement": "**Append** to the durable stores beside them — history, refusals, settings, the build's edge cache.",
          "lastTouchedAt": 1789205493
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-j3p010",
      "kind": "component",
      "name": "Working Tree Probes",
      "parentId": "node-t58dyd",
      "description": "What the working tree says: which files changed since the last sync, and what a project directory contains.",
      "responsibilities": [
        {
          "id": "resp-cyfvkb",
          "statement": "**Report** which files changed since a sync point, from git when there is a repository and file mtimes otherwise.",
          "lastTouchedAt": 1789205493
        },
        {
          "id": "resp-tc1a8z",
          "statement": "**Walk** a project directory for its manifests, its product files and its shape.",
          "lastTouchedAt": 1789205493
        }
      ],
      "layer": "infrastructure"
    },
    {
      "id": "node-ccavdy",
      "kind": "component",
      "name": "Fold Rules",
      "parentId": "node-t58dyd",
      "description": "Which copy of a node, group or claim lands in the committed model when work folds.",
      "responsibilities": [
        {
          "id": "resp-kn5xvs",
          "statement": "**Decide** what a folded element keeps: dropping claims awaiting a verdict or tagged to another change, and clearing drift flags on the rest.",
          "lastTouchedAt": 1789205493
        }
      ],
      "layer": "application"
    },
    {
      "id": "node-vm1dcf",
      "kind": "component",
      "name": "Public Entry Points",
      "parentId": "node-t58dyd",
      "description": "What another container calls: the project's model, its history, its drift, its styles — without naming the adapter behind any of them.",
      "responsibilities": [
        {
          "id": "resp-qs27jh",
          "statement": "**Hand** a caller the model layers, the history, the refusals, the settings and the style table for a project, wiring the adapter each one needs.",
          "lastTouchedAt": 1789205493
        },
        {
          "id": "resp-cy6bqc",
          "statement": "**Answer** what changed and what the model claims about a file, reading both layers to do it.",
          "lastTouchedAt": 1789205493
        }
      ],
      "layer": "composition"
    },
    {
      "id": "node-ev4nbt",
      "kind": "component",
      "name": "Symbol Resolution",
      "parentId": "node-j8vc9h",
      "description": "Finds a named definition in source text with tree-sitter, so an anchor can be verified without the model.",
      "responsibilities": [
        {
          "id": "resp-w30n4j",
          "statement": "**Resolve** a symbol name to its line span in a source file, preferring the definition nearest a remembered position.",
          "lastTouchedAt": 1789208276
        }
      ],
      "layer": "core"
    },
    {
      "id": "node-9562dh",
      "kind": "component",
      "name": "MCP Integration Setup",
      "parentId": "node-v54st6",
      "description": "Detecting which AI tools a project is wired to, and wiring the ones it isn't.",
      "responsibilities": [
        {
          "id": "resp-5ttbax",
          "statement": "**Report** which AI tools this project has scryer's MCP server, hooks and status line installed for.",
          "lastTouchedAt": 1789208708
        },
        {
          "id": "resp-9y887c",
          "statement": "**Install** the MCP entry, session hooks or status line for a tool on request, and **re-check** afterwards.",
          "lastTouchedAt": 1789208708
        }
      ],
      "layer": "features"
    },
    {
      "id": "node-t40099",
      "kind": "symbol",
      "name": "collect_cs_scope",
      "parentId": "node-t8gbfh",
      "responsibilities": [
        {
          "id": "resp-yqsm59",
          "statement": "Captures a C# file's namespace declarations, its `using` directives (global, static, and alias forms), and the top-level types each namespace declares.",
          "lastTouchedAt": 1790185515
        }
      ]
    },
    {
      "id": "node-9r9vds",
      "kind": "symbol",
      "name": "collect_clojure",
      "parentId": "node-439",
      "responsibilities": [
        {
          "id": "resp-6tjtn4",
          "statement": "**When** a list's head names a defining form, **record** the following symbol as a definition, ignoring quoted, discarded and commented code",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-wr982x",
      "kind": "symbol",
      "name": "collect_clj_idents",
      "parentId": "node-439",
      "responsibilities": [
        {
          "id": "resp-k3sjnc",
          "statement": "**When** a symbol carries a namespace qualifier, **withhold** its bare name from same-namespace matching",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-xcj8a0",
      "kind": "symbol",
      "name": "collect_clj_imports",
      "parentId": "node-439",
      "responsibilities": [
        {
          "id": "resp-vk8n9a",
          "statement": "**When** a namespace declaration lists requires, **record** each required namespace with its alias and referred names",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-1efzfr",
      "kind": "symbol",
      "name": "resolve_clj_ns",
      "parentId": "node-448",
      "responsibilities": [
        {
          "id": "resp-x31891",
          "statement": "**When** a namespace is required, **resolve** it to the file that declares it under a declared source root",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-w99evg",
      "kind": "symbol",
      "name": "edn_string_vec",
      "parentId": "node-472",
      "responsibilities": [
        {
          "id": "resp-q9rhp4",
          "statement": "**When** a Clojure build descriptor is read, **extract** the source roots it declares",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-xwabz2",
      "kind": "symbol",
      "name": "project_clj_header",
      "parentId": "node-472",
      "responsibilities": [
        {
          "id": "resp-rfybmq",
          "statement": "**When** a Leiningen project is read, **extract** its declared name and source paths",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-44qyjm",
      "kind": "symbol",
      "name": "resolve_via_extractor",
      "parentId": "node-405",
      "responsibilities": [
        {
          "id": "resp-8n3sxq",
          "statement": "**When** a language declares its definitions through macros, **resolve** the symbol through the extractor's definition list",
          "lastTouchedAt": 1789073110
        }
      ]
    },
    {
      "id": "node-b42pqv",
      "kind": "symbol",
      "name": "hook_install_status",
      "parentId": "node-7vjcgn",
      "responsibilities": [
        {
          "id": "resp-mm76pz",
          "statement": "**When** a tool's hook settings hold exactly the current scryer registration set, **reports** the install as current",
          "lastTouchedAt": 1790938916
        },
        {
          "id": "resp-1pv0ha",
          "statement": "**When** a tool's hook settings hold scryer entries that differ from the current registration set, **reports** the install as outdated",
          "lastTouchedAt": 1790938916
        },
        {
          "id": "resp-463yda",
          "statement": "**If** a scryer hook entry names a scryer-mcp binary that no longer exists, **then** **reports** the install as outdated",
          "lastTouchedAt": 1790938916
        }
      ]
    },
    {
      "id": "node-5mk6t0",
      "kind": "symbol",
      "name": "hooksToUpdate",
      "parentId": "node-9562dh",
      "responsibilities": [
        {
          "id": "resp-6n0gsn",
          "statement": "**When** a detected tool's session hooks are outdated, **lists** that tool among the hooks to update",
          "lastTouchedAt": 1790938916
        }
      ]
    },
    {
      "id": "node-cst49n",
      "kind": "symbol",
      "name": "HooksRow",
      "parentId": "node-1bwtge",
      "responsibilities": [
        {
          "id": "resp-6p9870",
          "statement": "**When** a tool's session hooks are outdated, **shows** an Update action in place of Installed",
          "lastTouchedAt": 1790938916
        }
      ]
    },
    {
      "id": "node-vd81jd",
      "kind": "symbol",
      "name": "StructuralViolationList",
      "parentId": "node-35zvw4",
      "responsibilities": [
        {
          "id": "resp-rnz1pv",
          "statement": "**When** the user expands the structural notice, **lists** each violation under the container whose style it breaks, with the charged component, the file to fix and what is wrong",
          "lastTouchedAt": 1790938916
        }
      ]
    },
    {
      "id": "node-45vp3y",
      "kind": "symbol",
      "name": "StructuralCount",
      "parentId": "node-b9sv18",
      "responsibilities": [
        {
          "id": "resp-5nhv0y",
          "statement": "**When** the structural check charges violations inside a node's subtree, **shows** their count, orange when every one is an undeclared style and red otherwise",
          "lastTouchedAt": 1790938916
        }
      ]
    },
    {
      "id": "node-7h6fth",
      "kind": "component",
      "name": "Session Ledger Wiring",
      "parentId": "node-t58dyd",
      "description": "The session-log entry points the hook client and MCP tools call: prompts, asks, touches.",
      "responsibilities": [
        {
          "id": "resp-xxh3fn",
          "statement": "**When** a shell command finishes, **records** every project file modified since it started as touched by the session",
          "lastTouchedAt": 1790939637
        },
        {
          "id": "resp-zhxm92",
          "statement": "**If** another session logged editing a file while a shell command ran, **then** **leaves** that file out of the command's touches",
          "lastTouchedAt": 1790940258
        },
        {
          "id": "resp-vwxq2g",
          "statement": "**If** an edited file lies outside the project, **then** **leaves** it out of the session's touches",
          "lastTouchedAt": 1790940537
        },
        {
          "id": "resp-2pxfn5",
          "statement": "**When** the session first reads a file, **records** which of its claims are already out of sync with the code",
          "lastTouchedAt": 1790942328
        },
        {
          "id": "resp-drjc6x",
          "statement": "**If** a claim was already out of sync when the session first read its file and is in the same state at stop, **then** **leaves** it out of the close gate",
          "lastTouchedAt": 1790942328
        },
        {
          "id": "resp-sbg2z1",
          "statement": "**When** the close gate blocks, **lists** one line per file with its claims counted once each by state, at most eight files",
          "lastTouchedAt": 1790942328
        },
        {
          "id": "resp-5wz5x1",
          "statement": "**If** the session has edited no file since it planned an entry, **then** **leaves** that entry out of the stop gate",
          "lastTouchedAt": 1790956390
        }
      ],
      "layer": "composition"
    },
    {
      "id": "node-da3a8k",
      "kind": "symbol",
      "name": "user_prompt_submit",
      "parentId": "node-erg0zt",
      "responsibilities": [
        {
          "id": "resp-rjfsrz",
          "statement": "**Binds** the harness process to the session on each prompt, so an MCP server spawned before a /clear follows the session",
          "lastTouchedAt": 1790941215
        }
      ]
    }
  ],
