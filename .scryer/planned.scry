      "parentId": "node-a1fh6z",
      "responsibilities": [
        {
          "id": "resp-bqkzc5",
          "statement": "Seeds the reconcile anchor to now (reporting nothing) on a never-reconciled model, then reports out-of-plan drift scopes thereafter.",
