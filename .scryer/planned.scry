    {
      "id": "node-7ecyk8",
      "kind": "symbol",
      "name": "check_code",
      "parentId": "node-j8g0kq",
      "responsibilities": [
        {
          "id": "resp-f4g48k",
          "statement": "Runs every code-time style check against the build's derived dependency graph and external imports: layer legality, same-layer isolation with public-surface exceptions, banned-package imports, and path-convention misplacement — each violation charged to the component that must fix it.",
          "lastTouchedAt": 1788959020
        },
        {
          "id": "resp-as9xwv",
          "statement": "**When** a declared model link breaks its style's legality rules, **reports** it as a forbidden link charged to the linking component",
          "lastTouchedAt": 1789125485
        },
        {
          "id": "resp-0pssms",
          "statement": "**If** an import leaves a styled container from a layer outside its style's outbound layers, **then** **reports** a layer violation charged to the importer",
          "lastTouchedAt": 1789125460
        },
        {
          "id": "resp-x4q31x",
          "statement": "**When** an import enters a container whose style is imported as a module, **checks** the importing layer against the importer's own matrix, and against its outbound layers for the library's facade.",
          "lastTouchedAt": 1789206005
        },
        {
          "id": "resp-trj25g",
          "statement": "**If** a code edge was only guessed from a matching name, **then** **charge** no structural violation for it.",
          "lastTouchedAt": 1790185503
        }
      ]
    },
    {
      "id": "node-6w47yt",
      "kind": "component",
      "name": "Test Result Matching",
