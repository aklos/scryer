      "responsibilities": [
        {
          "id": "resp-awanca",
          "statement": "**Render** the architecture model as an interactive canvas of nodes, links, and groups.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-ypenxc",
          "statement": "**Let** a developer author responsibilities, links, and styles on the model.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-bk2zzq",
          "statement": "**Visualize** drift, test coverage, and style conformance against the model.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-kqn7x2",
          "statement": "**Surface** AI agent sessions for model building so a developer can follow and steer them.",
          "lastTouchedAt": 1788958170
        }
      ],
      "style": "feature-sliced"
    },
