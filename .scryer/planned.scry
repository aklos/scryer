        }
      ]
    },
    {
      "id": "node-110",
      "kind": "component",
      "name": "Model Reading & Query",
      "parentId": "node-6",
      "description": "Every read-only view of the model: overview, subtree, search, structured query, health, drift, and task orientation.",
      "responsibilities": [
        {
          "id": "resp-144",
          "statement": "Renders the model at the granularity an agent needs — architecture overview, one node's full subtree, or a file's governing slice — sized to never blow the agent's context.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-145",
          "statement": "Answers fuzzy text search and structured field-predicate queries over the model.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-146",
          "statement": "Reports coverage/health, drift status, and the implement queue (the plan-vs-committed diff) as the agent's standing work signals.",
          "lastTouchedAt": 1784883763
        },
        {
          "id": "resp-147",
          "statement": "Bundles the governing claims, directives, pending work, and matching rules for a task or file into one orientation call.",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-111",
      "kind": "symbol",
      "name": "score_node",
      "parentId": "node-110",
      "responsibilities": [
        {
          "id": "resp-148",
          "statement": "Scores a node's searchable fields against query terms, requiring every term to clear its fuzzy-match threshold somewhere (AND).",
          "lastTouchedAt": 1784883763
        }
      ]
    },
    {
      "id": "node-112",
      "kind": "symbol",
      "name": "overview_payload",
      "parentId": "node-110",
      "responsibilities": [
        {
          "id": "resp-149",
          "statement": "Builds the architecture overview: the model tree down to components with counts, always small enough to read whole.",
