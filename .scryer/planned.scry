        }
      ]
    },
    {
      "id": "node-541",
      "kind": "symbol",
      "name": "read_planned_at",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-589",
          "statement": "Reads the planned draft, falling back to the committed model when no plan has diverged yet",
