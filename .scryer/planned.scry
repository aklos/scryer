    {
      "id": "node-a1fh6z",
      "kind": "component",
      "name": "Model Health & Drift Status",
      "parentId": "node-j8vc9h",
      "description": "Computes deterministic, agent-free readings of the model's standing: drift, completeness, anchor health, structural conformance, and test/probe verdicts.",
      "responsibilities": [
        {
          "id": "resp-wtd48m",
          "statement": "Computes a cheap, agent-free drift status — out-of-plan regressions to mapped code — to nudge a semantic recheck without ever crying wolf on a never-reconciled model.",
          "lastTouchedAt": 1788959116
        },
        {
          "id": "resp-f0znm9",
          "statement": "Runs the full deterministic health pass off the IPC thread: per-node completeness, anchor fingerprint checks with silent re-anchoring, structural style conformance, and link evidence.",
          "lastTouchedAt": 1788959116
        },
        {
          "id": "resp-kd8x2h",
          "statement": "Serves per-claim test and probe verdicts from the status cache, re-verified against the working tree.",
          "lastTouchedAt": 1788959116
        },
        {
          "id": "resp-3y1wcb",
          "statement": "Lets the developer dismiss drift for the whole project or for one node's subtree by advancing the reconcile anchor without running a semantic check.",
          "lastTouchedAt": 1788959116
        }
      ],
      "layer": "shell"
    },
    {
      "id": "node-da1fd3",
      "kind": "symbol",
