    },
    {
      "id": "node-513",
      "kind": "component",
      "name": "Agent Runtime",
      "parentId": "node-3",
      "description": "Owns the background thread that spawns, multiplexes, and tears down agent subprocess sessions - CLI print-mode and the ACP protocol - parsing their streamed output into AgentEvents.",
      "responsibilities": [
        {
          "id": "resp-563",
          "statement": "Runs a dedicated runtime thread that multiplexes many concurrent agent sessions and routes Start/Cancel/Done commands to them",
          "lastTouchedAt": 1784884036
        },
        {
          "id": "resp-564",
          "statement": "Spawns agent subprocesses with only the integrations required for their assigned workflow",
          "concern": "security",
          "lastTouchedAt": 1785805729
        },
        {
          "id": "resp-565",
          "statement": "Parses streamed agent output - stream-json events, ACP notifications - into usage totals and human-readable activity summaries",
          "lastTouchedAt": 1784884036
        },
        {
          "id": "resp-566",
          "statement": "Force-kills an agent's entire process tree on cancellation",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-514",
      "kind": "symbol",
      "name": "LaunchMode",
      "parentId": "node-513",
      "properties": [
        {
          "label": "Cli",
          "description": "CLI print mode, using the user's subscription",
          "lastTouchedAt": 1784884036
        },
        {
          "label": "Acp",
          "description": "ACP subprocess",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-515",
      "kind": "symbol",
      "name": "RuntimeCommand",
      "parentId": "node-513",
      "properties": [
        {
          "label": "Start",
          "description": "Start a new agent session with its launch config and channels",
          "lastTouchedAt": 1784884036
        },
        {
          "label": "Cancel",
          "description": "Cancel every active session",
          "lastTouchedAt": 1784884036
        },
        {
          "label": "Done",
          "description": "A session finished naturally",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-516",
      "kind": "symbol",
      "name": "AcpRuntime",
      "parentId": "node-513",
      "responsibilities": [
        {
          "id": "resp-567",
          "statement": "**When** a caller starts a session, **await** its terminal result over a dedicated channel",
          "lastTouchedAt": 1784884036
        },
        {
          "id": "resp-568",
          "statement": "**When** a cancel is requested, **stop** every active session at once - for the user's stop button, a parallel build's many sessions, or orphan cleanup",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-517",
      "kind": "symbol",
      "name": "runtime_thread",
      "parentId": "node-513",
      "responsibilities": [
        {
          "id": "resp-569",
          "statement": "Owns the event loop that receives Start, Cancel, and Done commands and tracks per-session cancel handles keyed by a monotonic id",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-518",
      "kind": "symbol",
      "name": "start_cli_session",
      "parentId": "node-513",
      "responsibilities": [
        {
          "id": "resp-570",
          "statement": "Spawns and configures a CLI-mode agent subprocess (Claude Code, Codex, or Cursor), piping the prompt over stdin to avoid the OS argv size cap.",
          "lastTouchedAt": 1785544907
        }
      ]
    },
    {
      "id": "node-519",
      "kind": "symbol",
      "name": "extract_usage",
      "parentId": "node-513",
      "responsibilities": [
        {
          "id": "resp-571",
          "statement": "Extracts end-of-turn token usage from a Claude Code result event or a Codex token-count event in a stream-json line",
          "lastTouchedAt": 1784884036
        }
      ]
    },
    {
      "id": "node-520",
      "kind": "symbol",
      "name": "summarize_event",
      "parentId": "node-513",
      "responsibilities": [
        {
          "id": "resp-572",
          "statement": "Extracts a human-readable one-line activity summary, naming the file/node acted on, from a Claude Code stream-json event",
          "lastTouchedAt": 1784884036
