{
  "version": "0.3",
  "nodes": [
    {
      "id": "node-1",
      "kind": "system",
      "name": "scryer",
      "description": "A model-driven development tool that keeps an architecture model of responsibilities and tests next to a codebase, so a developer and their coding agent plan and verify changes against a shared spec.",
      "responsibilities": [
        {
          "id": "resp-10",
          "statement": "**Maintain** a shared architecture model of what the system is responsible for, mapped to source and tests.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-11",
          "statement": "**Detect** drift between the model and the codebase and **reconcile** it in either direction.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-12",
          "statement": "**Expose** the model to coding agents over MCP so they build and validate code against the plan.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-13",
          "statement": "**Present** the model to the developer for authoring, review, and navigation.",
          "lastTouchedAt": 1784883634
        }
      ]
    },
    {
      "id": "node-2",
      "kind": "container",
      "name": "Desktop UI",
      "parentId": "node-1",
      "technology": "React 19 + TypeScript (Vite)",
      "description": "The frontend rendering the model tree, node pages, diagrams, and live component previews inside the Tauri window.",
      "responsibilities": [
        {
          "id": "resp-14",
          "statement": "**Render** the model tree, node pages, and diagram view for browsing and editing the architecture model.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-15",
          "statement": "**Let** the developer author responsibilities, directives, links, and groups in place.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-16",
          "statement": "**Render** live previews of visual components through the preview workspace.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-17",
          "statement": "**Surface** plan and drift status so the developer sees the model's health at a glance.",
          "lastTouchedAt": 1784883634
        }
      ],
      "properties": [
        {
          "label": "cursor",
          "description": "Per-agent model and effort settings for Cursor CLI fills",
          "lastTouchedAt": 1785544979
        }
      ],
      "position": {
        "x": -840.0,
        "y": 552.0
      }
    },
    {
      "id": "node-3",
      "kind": "container",
      "name": "Agent Sync",
      "parentId": "node-1",
      "technology": "Rust (agent-client-protocol)",
      "description": "Spawns and drives coding-agent sessions over ACP to build models from a codebase and reconcile drift.",
      "responsibilities": [
        {
          "id": "resp-23",
          "statement": "**Spawn** a coding-agent session and **drive** it through the model-build or drift-reconciliation workflow.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-24",
          "statement": "**Translate** agent tool calls and progress into model updates and UI-visible session state.",
          "lastTouchedAt": 1784883634
        },
        {
          "id": "resp-687",
          "statement": "**Record** each CLI agent session's streamed stdout and stderr to per-session log files under `.scryer/build-logs`.",
          "lastTouchedAt": 1785545011
        }
      ],
      "properties": [
        {
          "label": "Cursor",
          "description": "The Cursor CLI agent harness",
          "lastTouchedAt": 1785544976
        }
