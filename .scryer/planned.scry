        }
      ]
    },
    {
      "id": "node-544",
      "kind": "symbol",
      "name": "stamp_touches",
      "parentId": "node-535",
      "responsibilities": [
        {
          "id": "resp-592",
          "statement": "**When** a responsibility or property's truth-bearing content is new or changed, **stamp** its last-touched date; otherwise carry the prior date forward",
