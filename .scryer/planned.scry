{
  "version": "0.3",
  "nodes": [
    {
      "id": "node-na1abn",
      "kind": "system",
      "name": "scryer",
      "description": "An architecture-modeling tool that keeps a living C4-style model of a codebase mapped to its source and tests, and drives AI coding agents through a plan-build-verify loop against that model.",
      "responsibilities": [
        {
          "id": "resp-edjwj9",
          "statement": "**Maintain** an architecture model of a codebase — its nodes, responsibilities, links, and mapping to source and tests.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-t7c0vr",
          "statement": "**Drive** AI coding agents through a plan, sign-off, build, and verify loop anchored to the model.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-mfctkp",
          "statement": "**Expose** the model and its rules so agents work through it rather than around it.",
          "lastTouchedAt": 1788958170
        },
        {
          "id": "resp-wrs6qd",
          "statement": "**Present** the model visually for a developer to author, review, and track drift and conformance.",
          "lastTouchedAt": 1788958170
        }
      ]
    },
    {
      "id": "node-v54st6",
      "kind": "container",
      "name": "Desktop App UI",
      "parentId": "node-na1abn",
